# API Configuration
VITE_API_BASE_URL=https://api.modl.gg

# Tenant domain override for local development (leave empty in production)
# VITE_TENANT_DOMAIN=yourserver.modl.gg

# Stripe (public key only - safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Realtime WebSocket client. Default ON. Set to false to hard-disable (kill-switch).
# VITE_REALTIME_ENABLED=false
